#!/data/data/com.termux/files/usr/bin/bash
# s24-adbx - run adb against this phone's own adbd, for the s24 gateway.
# Installed as $PREFIX/bin/s24-adbx. The gateway reaches it over SSH, so it works
# on Wi-Fi, LTE or 5G as long as the phone is on the tailnet.
#
#   s24-adbx ensure          connect to the local adbd if needed
#   s24-adbx shell B64       run a base64-encoded command as the adb shell user
#   s24-adbx exec-out B64    same, with binary-safe output (screencap and the like)
#   s24-adbx install APK     install or update an APK that is on the phone
#
# Commands arrive base64-encoded so they pass through SSH and two shells unquoted.
# Exit 69 (with an "s24-adbx:" message) means adb itself is unavailable.
#
# adbd lives on loopback and the port is NOT fixed: wireless debugging picks a
# fresh port every boot and Termux's adb has no mDNS. So the wrapper scans
# loopback once, caches the port, and re-scans only when the cache goes stale.
# Requires Wireless debugging left ON; a manual `adb tcpip 5555` is found too.
set -u
PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
CACHE=${TMPDIR:-$PREFIX/tmp}/.s24-adbx-port

probe() { # probe PORT -> ok when adbd on that loopback port answers
	local s
	s=$(timeout 6 adb -s "127.0.0.1:$1" get-state 2>/dev/null) || return 1
	[ "$s" = device ]
}

discover() { # prints a live adbd loopback port; scans only when cache is dead
	local p port wave
	port=
	[ -f "$CACHE" ] && read -r port <"$CACHE" 2>/dev/null
	port=${port:-}
	if [ -n "$port" ] && probe "$port" >/dev/null 2>&1; then
		printf '%s\n' "$port"
		return 0
	fi
	# loopback sweep in one python pass (500-fork bash storms are too slow on
	# the phone); probe each opener, first real adbd wins and gets cached.
	local p
	rm -f "$CACHE.raw"
	python3 - >"$CACHE.raw" 2>/dev/null <<'PY'
import socket
import concurrent.futures as cf
def chk(p):
	try:
		socket.create_connection(("127.0.0.1", p), 0.25).close()
		return p
	except Exception:
		return None
ports = [5555] + list(range(30000, 55001))
with cf.ThreadPoolExecutor(3000) as ex:
	for r in ex.map(chk, ports):
		if r:
			print(r)
PY
	for p in $(sort -n "$CACHE.raw" 2>/dev/null); do
		if probe "$p" >/dev/null 2>&1; then
			printf '%s\n' "$p" >"$CACHE"
			rm -f "$CACHE.raw"
			printf '%s\n' "$p"
			return 0
		fi
	done
	rm -f "$CACHE.raw"
	return 1
}

ensure() {
	local port
	port=$(discover) || { echo "s24-adbx: no local adbd listener - leave Wireless debugging ON" >&2; exit 69; }
	SERIAL="127.0.0.1:$port"
	adb -s "$SERIAL" get-state >/dev/null 2>&1 || adb connect "$SERIAL" >/dev/null 2>&1
	probe "$port" || { echo "s24-adbx: local adbd is not usable on $SERIAL" >&2; exit 69; }
}

case "${1:-}" in
	ensure) ensure; echo device ;;
	shell | exec-out)
		[ $# -eq 2 ] || { echo "s24-adbx: usage: s24-adbx $1 B64" >&2; exit 64; }
		ensure
		cmd=$(printf %s "$2" | base64 -d) || { echo "s24-adbx: bad base64" >&2; exit 64; }
		exec adb -s "$SERIAL" "$1" "$cmd" ;;
	install)
		[ $# -eq 2 ] || { echo "s24-adbx: usage: s24-adbx install APK" >&2; exit 64; }
		ensure
		exec adb -s "$SERIAL" install -r "$2" ;;
	*) sed -n '6,9p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 64 ;;
esac
